// --- Test Case: Full & Expanded Memory Sequence ---
// --- Part 1: Original Test (RegB -> Mem -> RegA) ---
// Inst 0: MOV B, 99      | Loads the immediate value 99 into register B.
000001101100011
// Inst 1: MOV (1), B     | Stores the value from register B into data memory at address 1.
010100000000001
// Inst 2: MOV A, (1)     | Loads the value from data memory at address 1 into register A.
010010100000001

// --- Part 2: Symmetric Test (RegA -> Mem -> RegB) ---
// Inst 3: MOV A, 123     | Loads the immediate value 123 into register A.
000001001111011
// Inst 4: MOV (2), A     | Stores the value from register A into data memory at address 2.
010011100000010
// Inst 5: MOV B, (2)     | Loads the value from data memory at address 2 into register B.
010011000000010

// --- Part 3: Overwrite and Edge Case Test (0 and 255) ---
// Inst 6: MOV A, 255     | Loads the immediate value 255 into register A.
000001011111111
// Inst 7: MOV (1), A     | Stores 255 into DM at address 1, overwriting the previous value.
010011100000001
// Inst 8: MOV A, 0       | Loads the immediate value 0 into register A.
000001000000000
// Inst 9: MOV A, (1)     | Loads the value from DM at address 1 (which is 255) into register A.
010010100000001

// --- Test Case: ADD A, (Dir) ---
// Goal: Verify A = A + Mem[Dir]. Expected result in A is 150.
// Inst 10: MOV A, 100    | Loads the operand 100 into register A.
000001001100100
// Inst 11: MOV B, 50     | Loads the operand 50 into register B.
000001100110010
// Inst 12: MOV (3), B    | Stores the value from register B into memory at address 3.
010100000000011
// Inst 13: ADD A, (3)    | Adds the value from DM[3] to register A (A = 100 + 50 = 150).
010110000000011